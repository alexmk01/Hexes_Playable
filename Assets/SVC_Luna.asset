            = texture(_MainTex, u_xlat0.xy, _GlobalMipBias.x).xyz;\n    u_xlat0.xyz
            = u_xlat16_0.xyz * _BaseColor.xyz;\n    SV_Target0.xyz = u_xlat0.xyz;\n   
            SV_Target0.w = 1.0;\n    return;\n}\n\n"
